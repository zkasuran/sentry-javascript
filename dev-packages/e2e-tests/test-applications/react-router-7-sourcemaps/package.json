    "@sentry-internal/test-utils": "link:../../../test-utils",
    "@types/node": "^18.19.1",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "tsx": "4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
